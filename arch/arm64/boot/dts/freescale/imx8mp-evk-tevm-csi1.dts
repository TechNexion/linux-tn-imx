#include "imx8mp-evk.dts"

/ {
	model = "NXP i.MX8MPlus EVK with TechNexion TEVS on CSI1";
};

&iomuxc {
	tevs_pinctrl_csi1_ctrl: tevs-csi1-ctrl-grp {
		fsl,pins = <
			/* TEVS standby */
			MX8MP_IOMUXC_SD1_STROBE__GPIO2_IO11	0x9

			/* TEVS host power */
			MX8MP_IOMUXC_GPIO1_IO07__GPIO1_IO07	0x9
		>;
	};

	tevs_pinctrl_csi1_mclk: tevs-csi1-mclk-grp {
		fsl,pins = <
			MX8MP_IOMUXC_GPIO1_IO15__GPIO1_IO15	0x9
		>;
	};

	tevs_pinctrl_csi1_rst: tevs-csi1-rst-grp {
		fsl,pins = <
			MX8MP_IOMUXC_GPIO1_IO06__GPIO1_IO06	0x19
		>;
	};
};

/*
 * Disable CSI0 because this DTS uses CSI1.
 */
&mipi_csi_0 {
	status = "disabled";
};

/*
 * CSI1 sensor connection.
 * port@1/reg = 1 identifies the second MIPI-CSI interface
 * in the NXP legacy capture framework.
 */
&mipi_csi_1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	port@1 {
		reg = <1>;

		mipi_csi1_ep: endpoint {
			remote-endpoint = <&tevs_1_ep>;
			data-lanes = <4>;
			csis-hs-settle = <13>;
			csis-clk-settle = <2>;
			csis-wclk;
		};
	};
};

/*
 * CSI0 normally uses ISI0.
 * Disable it because this DTS uses CSI1.
 */
&isi_0 {
	status = "disabled";
};

/*
 * CSI1 uses ISI1.
 */
&isi_1 {
	status = "okay";

	cap_device {
		status = "okay";
	};
};

&i2c3 {
	clock-frequency = <400000>;
	status = "okay";

	/delete-node/ ov5640_mipi@3c;

	tevs_1: tevs@48 {
		compatible = "tn,tevs";
		reg = <0x48>;
		status = "okay";

		pinctrl-names = "default";
		pinctrl-0 = <
			&tevs_pinctrl_csi1_ctrl
			&tevs_pinctrl_csi1_rst
			&tevs_pinctrl_csi1_mclk
		>;

		host-power-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
		standby-gpios = <&gpio2 11 GPIO_ACTIVE_HIGH>;

		csi_id = <1>;

		port {
			tevs_1_ep: endpoint {
				remote-endpoint = <&mipi_csi1_ep>;
				data-lanes = <1 2 3 4>;
				clock-lanes = <0>;
				clock-noncontinuous;
				link-frequencies = /bits/ 64 <400000000>;
			};
		};
	};

	imu_0: lsm6dsm@6a {
		compatible = "st,lsm6dso16is";
		reg = <0x6a>;
	};
};