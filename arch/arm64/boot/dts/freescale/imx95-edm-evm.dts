/dts-v1/;

#include <dt-bindings/phy/phy-imx8-pcie.h>
#include "imx95-edm.dtsi"

/ {
	model = "TechNexion EDM-IMX95 and EVM baseboard";
	compatible = "fsl,imx95-edm", "fsl,imx95";

	aliases {
		ethernet0 = &enetc_port1;
		ethernet1 = &enetc_port2;
		rtc0 = &rtc_ds1337;
		rtc1 = &scmi_bbm;
	};

	leds {
		compatible = "gpio-leds";

		led0: led-user1 {
			label = "user1";
			gpios = <&tca9555_a21 2 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led1: led-user2 {
			label = "user2";
			gpios = <&tca9555_a21 3 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
	};

	reg_lvds_pwr: regulator_lvdspwr {	/* LVDS0_VDDEN */
		compatible = "regulator-fixed";
		regulator-name = "lvds0_vdden";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&tca9555_a21 0 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		status = "disabled";
	};

	lvds0_backlight: lvds0_backlight {
		compatible = "pwm-backlight";
		pwms = <&tpm5 0 50000 0>;
		brightness-levels = <0 36 72 108 144 180 216 255>;
		default-brightness-level = <6>;
		enable-gpios = <&tca9555_a21 1 GPIO_ACTIVE_HIGH>;	/* LVDS0_BL_EN */
		status = "disabled";
	};

	usb_hub_rst: usb_hub_rst {
		compatible = "gpio-reset";
		reset-gpios = <&tca9555_c21 11 GPIO_ACTIVE_LOW>;
		reset-delay-us = <10>;
		#reset-cells = <0>;
	};

	reg_usb_otg_vbus: usb_otg_vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_otg_vbus";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&tca9555_a22 0 GPIO_ACTIVE_LOW>;
		enable-active-low;
	};

	reg_pcie0_pwr: regulator-pcie0-pwr {	/* PCIE1 M.2 B key */
		compatible = "regulator-fixed";
		regulator-name = "PCIe slot-power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&tca9555_c21 2 GPIO_ACTIVE_HIGH>;	/* M2_B_PWR_EN */
		enable-active-high;
	};

	reg_pcie1_pwr: regulator-pcie1-pwr {	/* PCIE2 M.2 M key_1 */
		compatible = "regulator-fixed";
		regulator-name = "PCIe slot-power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&tca9555_c21 4 GPIO_ACTIVE_HIGH>;	/* M2_M1_PWR_EN */
		enable-active-high;
	};

	reg_serdes_eth_phy_pwr: regulator-pcie1-pwr {	/* PCIE2 M.2 M key_2 */
		compatible = "regulator-fixed";
		regulator-name = "SERDES ETH PHY PWR";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&tca9555_c21 5 GPIO_ACTIVE_HIGH>;	/*	M2_M2_PWR_EN */
		enable-active-high;
		regulator-always-on;
	};

	tlv320_mclk: clk-0 {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <12000000>;
	};

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "tlv320aic3x-audio";
		simple-audio-card,widgets =
			"Headphone", "Headphone Jack",
			"Microphone", "Mic Jack",
			"Line", "Line Out";
		simple-audio-card,routing =
			"Headphone Jack", "HPLOUT",
			"Headphone Jack", "HPROUT",
			"Line Out", "HPLCOM",
			"Line Out", "HPRCOM",
			"MIC2R", "Mic Jack",
			"Mic Jack", "Mic Bias";
		simple-audio-card,format = "dsp_b";
		simple-audio-card,bitclock-master = <&sound_master>;
		simple-audio-card,frame-master = <&sound_master>;
		simple-audio-card,bitclock-inversion;
		status = "okay";

		simple-audio-card,cpu {
			sound-dai = <&sai3>;
		};

		sound_master: simple-audio-card,codec {
			sound-dai = <&tlv320aic3104>;
			clocks = <&tlv320_mclk>;
		};
	};

	mdio_gpio: mdio-gpio {
		compatible = "virtual,mdio-gpio";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_mdio_gpio>;
		gpios = <&gpio4 0 GPIO_ACTIVE_HIGH>, /* mdc */
			<&gpio4 1 GPIO_ACTIVE_HIGH>; /* mdio */
		status = "okay";

		#address-cells = <1>;
		#size-cells = <0>;

		ethphy2: ethernet-phy2@1 { /* RTL8211F on baseboard */
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <1>;
			reset-gpios = <&tca9555_a22 1 GPIO_ACTIVE_LOW>;
			reset-assert-us = <35000>;
			reset-deassert-us = <75000>;
			eee-broken-1000t;
			realtek,aldps-disable;
			realtek,clkout-disable;
		};
	};

	fan0: pwm-fan {
		compatible = "pwm-fan";
		cooling-min-state = <0>;
		cooling-max-state = <3>;
		#cooling-cells = <2>;
		pwms = <&pca9685_pwm 0 4000000>;
		cooling-levels = <255 192 128 64>;
		fan-supply = <&reg_fan>;
	};

        reg_fan: regulator-fan {
		compatible = "regulator-fixed";
		regulator-name = "fan-supply";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&tca9555_c21 6 GPIO_ACTIVE_LOW>;
		regulator-boot-on;
	};

	reg_can1_stby: regulator-can1-stby {
		compatible = "regulator-fixed";
		regulator-name = "can1-stby";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&tca9555_c21 9 GPIO_ACTIVE_LOW>;
		enable-active-low;
	};

	reg_can2_stby: regulator-can2-stby {
		compatible = "regulator-fixed";
		regulator-name = "can2-stby";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&tca9555_c21 10 GPIO_ACTIVE_LOW>;
		enable-active-low;
	};
};

&thermal_zones {
	a55 {
		cooling-maps {
			map1 {
				trip = <&atrip2>;
				cooling-device = <&fan0 0 1>;
			};
			map2 {
				trip = <&atrip3>;
				cooling-device = <&fan0 1 2>;
			};
			map3 {
				trip = <&atrip4>;
				cooling-device = <&fan0 2 3>;
			};
		};
	};
};

&flexcan1 {
	xceiver-supply = <&reg_can1_stby>;
	status = "okay";
};

&flexcan2 {
	xceiver-supply = <&reg_can2_stby>;
	status = "okay";
};

&pcie0 { /* PCIE1 M.2 B key */
	vpcie-supply = <&reg_pcie0_pwr>;
	status = "okay";
};

&pcie1 { /* PCIE2 M.2 M key_1 */
	vpcie-supply = <&reg_pcie1_pwr>;
	status = "okay";
};

&usb2 {
	dr_mode = "otg";
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			otg1_out_ep: endpoint {
				remote-endpoint = <&hd3ss3220_in_ep>;
			};
		};

		port@1 {
			reg = <1>;
			otg1_in_ep: endpoint {
				remote-endpoint = <&hd3ss3220_out_ep>;
			};
		};
	};
};

&usb3_dwc3 {
	dr_mode = "host";
	reset = <&usb_hub_rst>;
	status = "okay";	
};

/* I2C_CSI on EDM */
&lpi2c2 {
	status = "okay";

	tca9554_csi25: tca9554csi25@25 {
		compatible = "nxp,pca9554";
		reg = <0x25>;
		vcc-supply = <&reg_1p8v>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "okay";
		gpio-line-names = "EXPOSURE_TRIG_IN1", "FLASH_OUT1", "INFO_TRIG_IN1", "CAM_SHUTTER1", "PWR1_TIME0", "PWR1_TIME1", "PWR1_TIME2", "";
	};

	typec_hd3ss3220: hd3ss3220@47 {
		compatible = "ti,hd3ss3220";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_hd3ss3220_irq>;
		interrupts-extended = <&gpio2 7 IRQ_TYPE_LEVEL_LOW>;
		vbus-supply = <&reg_usb_otg_vbus>;
		reg = <0x47>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				hd3ss3220_in_ep: endpoint {
					remote-endpoint = <&otg1_out_ep>;
				};
			};

			port@1 {
				reg = <1>;
				hd3ss3220_out_ep: endpoint {
					remote-endpoint = <&otg1_in_ep>;
				};
			};
		};
	};

	rtc_ds1337: ds1337@68 {
		compatible = "dallas,ds1337";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_rtc_irq>;
		reg = <0x68>;
		wakeup-source;
		interrupt-parent = <&gpio2>;
		interrupts = <13 IRQ_TYPE_LEVEL_LOW>;
	};
};

/* I2C_C on EDM */
&lpi2c3 {
	tca9555_c21: tca9555c21@21 {
		compatible = "nxp,pca9555";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_tca9555_c21_irq>;
		reg = <0x21>;
		vcc-supply = <&reg_3p3v>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio4>;
		interrupts = <29 IRQ_TYPE_LEVEL_LOW>;
		gpio-line-names = "M2_B_WWAN_WAKEN", "M2_B_WAN_DISABLEN", "M2_B_PWR_EN", "M2_B_RESET", "M2_M1_PWR_EN", "M2_M2_PWR_EN", "FAN_STBY", "USB_OTG_OC",
						  "RTC_INTA", "CAN1_STB", "CAN2_STB", "USB_HUB_RESET", "CSI1_PDB", "CSI2_PDB", "VCONN_FAULT", "AUD_RST";
		status = "okay";
	};

	pca9685_pwm:pca9685@55 {
		compatible = "nxp,pca9685-pwm";
		#pwm-cells = <2>;
		reg = <0x55>;
	};
};

/* I2C_D on EDM */
&lpi2c4 {
	status = "okay";

	pca9554_d23: tca9554d23@23 {
		compatible = "nxp,pca9554";
		reg = <0x23>;
		vcc-supply = <&reg_3p3v>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "okay";
		gpio-line-names = "DSI1_VDDEN", "DSI1_BL_EN", "DSI1_TE", "DSI1_RST", "DSI1_INT_N", "TOUCH_RST", "EEPROM_WP", "";
	};

	tca9554_d25: tca9554d25@25 {
		compatible = "nxp,pca9554";
		reg = <0x25>;
		vcc-supply = <&reg_1p8v>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "okay";
		gpio-line-names = "EXPOSURE_TRIG_IN2", "FLASH_OUT2", "INFO_TRIG_IN2", "CAM_SHUTTER2", "PWR2_TIME0", "PWR2_TIME1", "PWR2_TIME2", "";
	};
};

/* I2C_B on EDM */
&lpi2c5 {
	status = "okay";
	tlv320aic3104: tlv320aic3104@18 {
		#sound-dai-cells = <0>;
		compatible = "ti,tlv320aic3104"; /* ti,tlv320aic3x */
		reg = <0x18>;
		reset-gpios = <&tca9555_c21 15 GPIO_ACTIVE_LOW>;
		ai3x-ocmv = <0>;
		ai3x-micbias-vg = <1>;		/* 2.0V */

		/* Regulators */
		AVDD-supply = <&reg_3p3v>;
		IOVDD-supply = <&reg_3p3v>;
		DRVDD-supply = <&reg_3p3v>;
		DVDD-supply = <&reg_1p8v>;
	};

	eeprom_baseboard: eeprom@51 {
		compatible = "atmel,24c512";
		reg = <0x51>;
		pagesize = <128>;
		status = "okay";
	};
};


&lpi2c6 {
	status = "okay";

	/* Power monitor for VCC_12V_OUT */
	sensor_12v:ina219_12v@40 {
		compatible = "ti,ina219";
		reg = <0x40>;
		shunt-resistor = <2000>; /* .002 Ohm resistor = 2000 uOhms*/
	};

	/* Power monitor for VIN_5V0 */
	sensor_5v:ina219_5v@45 {
		compatible = "ti,ina219";
		reg = <0x45>;
		shunt-resistor = <2000>; /* .002 Ohm resistor = 2000 uOhms*/
	};
};

&enetc_port0 {	/* RTL8211F on baseboard */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enetc0>;
	phy-handle = <&ethphy2>;
	phy-mode = "rgmii-id";
	status = "okay";
};

&scmi_iomuxc {
	pinctrl_hd3ss3220_irq: hd3ss3220_irqgrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO07__GPIO2_IO_BIT7			0x91e /* GPIO_IO1 */
		>;
	};

	pinctrl_tca9555_c21_irq: tca9555_c21_irqgrp {
		fsl,pins = <
			IMX95_PAD_CCM_CLKO4__GPIO4_IO_BIT29			0x31e /* GPIO_IO4 */
		>;
	};

	pinctrl_touch_irq: touch_irqgrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO17__GPIO2_IO_BIT17			0x31e   /* Touch INT */
		>;
	};

	pinctrl_mipi_dsi_irq: mipidsiirqgrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO19__GPIO2_IO_BIT19			0x31e
		>;
	};

	pinctrl_rtc_irq: rtcirqgrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO13__GPIO2_IO_BIT13			0x31e
		>;
	};
};
