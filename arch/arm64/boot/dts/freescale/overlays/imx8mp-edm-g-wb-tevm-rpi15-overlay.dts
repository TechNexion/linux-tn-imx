/dts-v1/;
/plugin/;

#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/clock/imx8mp-clock.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	fragment@0 {
		target = <&mipi_csi_0>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			port@0 {
				reg = <0>;
				mipi_csi0_ep: endpoint {
					remote-endpoint = <&tevs_0_ep>;
					data-lanes = <2>;
					csis-hs-settle = <19>;
					csis-clk-settle = <2>;
					csis-wclk;
				};
			};
		};
	};

	fragment@1 {
		target = <&mipi_csi_1>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			port@1 {
				reg = <1>;
				mipi_csi1_ep: endpoint {
					remote-endpoint = <&tevs_1_ep>;
					data-lanes = <2>;
					csis-hs-settle = <19>;
					csis-clk-settle = <2>;
					csis-wclk;
				};
			};
		};
	};

	fragment@2 {
		target = <&i2c2>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;

			/delete-node/pca9555_a21;

			rpi15_io_expander_0: pca9554@21 {
				compatible = "nxp,pca9554";
				reg = <0x21>;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-line-names = "EXPOSURE_TRIG_IN",
								  "FLASH_OUT",
								  "STANDBY",
								  "SHUTTER",
								  "FRAME_SYNC",
								  "PWR_TIME0",
								  "PWR_TIME1",
								  "PWR_TIME2";
				status = "okay";
			};

			tevs_0: tevs@48 {
				compatible = "tn,tevs";
				reg = <0x48>;
				status = "okay";

				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_csi0_pwn>, <&pinctrl_csi0_rst>;
				reset-gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;
				standby-gpios = <&rpi15_io_expander_0 2 GPIO_ACTIVE_HIGH>;

				port {
					tevs_0_ep: endpoint {
						remote-endpoint = <&mipi_csi0_ep>;
						data-lanes = <1 2>;
						clock-lanes = <0>;
						clock-noncontinuous;
						link-frequencies = /bits/ 64 <400000000>;
					};
				};
			};

			imu_0: lsm6dsm@6a {
				compatible = "st,lsm6dso16is";
				reg = <0x6a>;
			};
		};
	};

	fragment@3 {
		target = <&i2c5>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;

			rpi15_io_expander_1: pca9554@21 {
				compatible = "nxp,pca9554";
				reg = <0x21>;
				gpio-controller;
				#gpio-cells = <2>;
				gpio-line-names = "EXPOSURE_TRIG_IN",
								  "FLASH_OUT",
								  "STANDBY",
								  "SHUTTER",
								  "FRAME_SYNC",
								  "PWR_TIME0",
								  "PWR_TIME1",
								  "PWR_TIME2";
				status = "okay";
			};

			tevs_1: tevs@48 {
				compatible = "tn,tevs";
				reg = <0x48>;
				status = "okay";

				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_csi1_pwn>, <&pinctrl_csi1_rst>;
				reset-gpios = <&gpio4 4 GPIO_ACTIVE_HIGH>;
				standby-gpios = <&rpi15_io_expander_1 2 GPIO_ACTIVE_HIGH>;

				port {
					tevs_1_ep: endpoint {
						remote-endpoint = <&mipi_csi1_ep>;
						data-lanes = <1 2>;
						clock-lanes = <0>;
						clock-noncontinuous;
						link-frequencies = /bits/ 64 <400000000>;
					};
				};
			};

			imu_1: lsm6dsm@6a {
				compatible = "st,lsm6dso16is";
				reg = <0x6a>;
			};
		};
	};
};
