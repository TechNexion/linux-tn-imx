/dts-v1/;
/plugin/;

#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/clock/imx93-clock.h>
#include <dt-bindings/gpio/gpio.h>

&{/} {
	disp_backlight: disp_backlight {
		post-pwm-on-delay-ms = <500>;
		status = "okay";
	};


	panel {
		compatible = "vxt,vl050-8048nt-c01";
		backlight = <&disp_backlight>;
		power-supply = <&reg_3p3v>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&display_out>;
			};
		};
	};
};

&parallel_disp_fmt {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lcdif>;
	fsl,interface-pix-fmt = "rgb888";
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@1 {
			reg = <1>;

			display_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};
};

&lcdif {
	assigned-clocks = <&clk IMX93_CLK_VIDEO_PLL>,
			  <&clk IMX93_CLK_MEDIA_DISP_PIX>,
			  <&clk IMX93_CLK_MEDIA_AXI>,
			  <&clk IMX93_CLK_MEDIA_APB>;
	assigned-clock-parents = <&clk IMX93_CLK_24M>,
				 <&clk IMX93_CLK_VIDEO_PLL>,
				 <&clk IMX93_CLK_SYS_PLL_PFD0>,
				 <&clk IMX93_CLK_SYS_PLL_PFD0_DIV2>;
	status = "okay";
};

&media_blk_ctrl {
	/* Disable the base DTS clock assignments for this display overlay. */
	assigned-clocks = <0>;
	assigned-clock-parents = <0>;
	assigned-clock-rates = <0>;
};

&tpm2 {
	status = "okay";
};

&lpi2c3 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	polytouch: edt-ft5x06@38 {
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_touch_irq>;
		compatible = "edt,edt-ft5x06";
		reg = <0x38>;
		interrupt-parent = <&gpio3>;
		interrupts = <26 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&tca9554pwr 7 GPIO_ACTIVE_LOW>; /* PICO_P32 */
		touchscreen-size-x = <800>;
		touchscreen-size-y = <480>;
	};
};
