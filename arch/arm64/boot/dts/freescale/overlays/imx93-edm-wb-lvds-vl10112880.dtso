/dts-v1/;
/plugin/;

#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>

&{/} {
	reg_lvds_pwr: regulator_lvdspwr {
		status = "okay";
	};

	reg_lvds_backlight_pwr: regulator_lvdsblpwr {
		status = "okay";
	};

	disp_backlight: disp_backlight {
		status = "okay";
	};

	lvds0_panel {
		compatible = "vxt,vl10112880", "panel-lvds";
		backlight = <&disp_backlight>;
		power-supply = <&reg_lvds_pwr>;

		data-mapping = "vesa-24";
		height-mm = <161>;
		width-mm = <243>;

		panel-timing {
			clock-frequency = <71100000>;
			hactive = <1280>;
			vactive = <800>;
			hback-porch = <40>;
			hfront-porch = <40>;
			vback-porch = <10>;
			vfront-porch = <3>;
			hsync-len = <80>;
			vsync-len = <10>;
			de-active = <1>;
		};

		port {
			panel_lvds_in: endpoint {
				remote-endpoint = <&lvds_out>;
			};
		};
	};
};

&ldb {
	status = "okay";
	lvds-channel@0 {
		#address-cells = <1>;
		#size-cells = <0>;
		fsl,data-mapping = "spwg";
		fsl,data-width = <24>;
		status = "okay";

		port@1 {
			reg = <1>;

			lvds_out: endpoint {
				remote-endpoint = <&panel_lvds_in>;
			};
		};
	};
};

&ldb_phy {
	status = "okay";
};

&lcdif {
	status = "okay";
	assigned-clock-rates = <498000000>, <71100000>, <400000000>, <133333333>;
};

&lpi2c3 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	exc80w46: touchscreen@2a {
		compatible = "eeti,exc80h60";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_i2ctouch1>;
		reg = <0x2a>;
		interrupt-parent = <&gpio3>;
		interrupts = <26 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&adp5585 0 GPIO_ACTIVE_LOW>;
	};
};